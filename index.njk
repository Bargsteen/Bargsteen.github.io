---
layout: layouts/base.njk
---

<section class="border-b border-base-300 bg-base-200 py-16 px-4">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-3">Hi, I'm Kasper</h1>
    <p class="text-lg opacity-70 max-w-xl leading-relaxed">
      Software engineer writing about F#, .NET, Rust, and other topics that catch my interest.
    </p>
  </div>
</section>

<section class="max-w-3xl mx-auto px-4 py-12">
  <h2 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-8">Recent Posts</h2>

  {% set postslist = collections.posts | take(-3) %}
  {% for post in postslist | reverse %}
  <article class="mb-10 pb-10 border-b border-base-200 last:border-0">
    <time class="text-sm font-mono opacity-50" datetime="{{ post.date }}">
      {{ post.date.getFullYear() }}, {{ post.date.getMonth() | toThreeLetterMonth }} {{ post.date.getDate() }}
    </time>
    <h3 class="text-2xl font-bold mt-1 mb-3">
      <a href="{{ post.url | url }}" class="hover:text-primary transition-colors duration-150">
        {{ post.data.title }}
      </a>
    </h3>
    <p class="opacity-70 leading-relaxed mb-4 text-base">
      {{ post.templateContent | excerpt }}
    </p>
    <a href="{{ post.url | url }}" class="text-primary text-sm font-medium hover:underline">
      Read more &rarr;
    </a>
  </article>
  {% endfor %}

  <p class="opacity-60 text-sm">
    More posts in <a href="{{ '/posts' | url }}" class="text-primary hover:underline">the archive</a>.
  </p>
</section>
