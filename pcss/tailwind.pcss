@tailwind base;
@tailwind components;

html {
  @apply subpixel-antialiased;

  &.dark {
    @apply antialiased;
  }
}

/* Prose styles for blog post content and markdown pages */
.markdown {
  @apply text-base sm:text-lg leading-normal;

  & > * {
    @apply mt-4 max-w-xl mx-auto;
  }

  & strong,
  & strong a {
    @apply font-bold;
  }

  & a {
    @apply border-b-4 border-primary;
  }

  & a:hover {
    @apply text-primary;
  }

  & h1 {
    @apply leading-tight text-3xl sm:text-4xl font-bold mt-6 mb-6;
  }

  & h2 {
    @apply leading-tight text-2xl sm:text-3xl font-bold mt-8;
  }

  & h3 {
    @apply leading-tight text-xl font-bold mt-6;
  }

  & pre {
    @apply max-w-4xl my-8 mx-auto !important;
  }

  & blockquote {
    @apply border-l-4 border-base-300 pl-4 italic opacity-80;
  }

  & ul,
  & ol {
    @apply pl-5 sm:pl-10;
  }

  & ul {
    @apply list-disc;
  }

  & ol {
    @apply list-decimal;
  }
}

.markdown p code {
  @apply bg-base-200 px-1 rounded text-sm;
}

/* Needed because postslist can appear inside markdown-styled contexts */
ul.postslist {
  @apply list-none list-outside pl-0;
}

@tailwind utilities;
