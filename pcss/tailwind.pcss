@tailwind base;
@tailwind components;

html {
  @apply subpixel-antialiased;

  &.dark {
    @apply antialiased;
  }
}

/* Profile photo - polaroid-style frame with slight rotation */
.profile-frame {
  @apply bg-base-100 p-1.5 rounded-lg shadow-lg;
  transform: rotate(2deg);
  border: 1px solid oklch(var(--b3));
}

.profile-frame img {
  filter: grayscale(30%) sepia(40%) contrast(1.05) brightness(1.02) saturate(0.9);
}

/* Nav link styles */
.nav-link {
  position: relative;

  &::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: oklch(var(--p));
    transition: width 0.25s ease, left 0.25s ease;
    border-radius: 1px;
  }

  &:hover::after {
    width: 60%;
    left: 20%;
  }
}

/* Post card styles */
.post-card {
  @apply pl-5 pb-6 mb-0 border-l-3 border-base-300;
  transition: border-color 0.2s ease;

  &:hover {
    border-left-color: oklch(var(--p));
  }

  &:last-child {
    @apply mb-0;
  }
}

/* Prose styles for blog post content and markdown pages */
.markdown {
  @apply text-lg leading-relaxed font-sans;

  & > * {
    @apply mt-5;
  }

  & strong,
  & strong a {
    @apply font-bold;
  }

  & a {
    @apply text-primary underline decoration-primary/40 decoration-2 underline-offset-2;
    transition: text-decoration-color 0.2s ease;
  }

  & a:hover {
    @apply decoration-primary;
  }

  & h1 {
    @apply leading-tight text-3xl sm:text-4xl font-display font-bold mt-10 mb-5;
  }

  & h2 {
    @apply leading-tight text-2xl sm:text-3xl font-display font-bold mt-12;
  }

  & h3 {
    @apply leading-tight text-xl font-display font-bold mt-8;
  }

  & pre {
    @apply max-w-4xl my-8 mx-auto !important;
  }

  & blockquote {
    @apply border-l-4 border-secondary/40 pl-5 italic opacity-80;
  }

  & ul,
  & ol {
    @apply pl-5 sm:pl-10;
  }

  & ul {
    @apply list-disc;
  }

  & ol {
    @apply list-decimal;
  }
}

.markdown p code {
  @apply bg-base-200 px-1.5 py-0.5 rounded text-sm font-mono;
}

/* Figure styling */
.markdown .figure-styled {
  @apply mt-8 mb-8;
}

.markdown .figure-styled img {
  @apply rounded-lg shadow-md border border-base-300;
}

.markdown .figure-styled figcaption {
  @apply text-sm italic text-base-content/50 pt-3;
}

/* Video styling within figures */
.markdown .figure-styled .aspect-w-16 {
  @apply rounded-lg overflow-hidden shadow-md;
  border: 1px solid oklch(var(--b3));
}

/* Code block enhancements */
.markdown pre[class*="language-"] {
  @apply shadow-lg;
  border: 1px solid oklch(var(--bc) / 0.06);
  border-top: 3px solid oklch(var(--p));
}

/* Needed because postslist can appear inside markdown-styled contexts */
ul.postslist {
  @apply list-none list-outside pl-0;
}

/* Tag pills */
.tag-pill {
  @apply inline-block text-xs font-mono font-medium tracking-wide px-2.5 py-1 rounded-full
         bg-secondary/10 text-secondary
         transition-colors duration-150;
}

.tag-pill:hover {
  @apply bg-secondary/20;
}

.tag-pill-active {
  @apply bg-primary text-primary-content;
}

/* Tag filter buttons */
.tag-filter-btn {
  @apply inline-block text-xs font-mono font-medium tracking-wide px-3 py-1.5 rounded-full
         border border-base-300 text-base-content/70
         transition-all duration-150 cursor-pointer select-none;
}

.tag-filter-btn:hover {
  @apply border-primary/50 text-primary;
}

.tag-filter-btn.active {
  @apply bg-primary text-primary-content border-primary;
}

@tailwind utilities;

/* Custom border-width (needs to be after utilities) */
.border-l-3 {
  border-left-width: 3px;
}
