---
layout: layouts/base.njk
---
<article class="max-w-3xl mx-auto px-4 py-12">
  <header class="mb-10">
    <h1 class="text-4xl font-bold leading-tight mb-3">{{ title }}</h1>
    {% if page.date %}
    <time class="text-sm font-mono opacity-60" datetime="{{ page.date }}">
      {{ page.date.getFullYear() }}, {{ page.date.getMonth() | toThreeLetterMonth }} {{ page.date.getDate() }}
    </time>
    {% endif %}
  </header>
  <div class="markdown">
    {{ content | safe }}
  </div>
</article>
