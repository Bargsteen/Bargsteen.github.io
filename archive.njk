---
layout: layouts/base.njk
permalink: /posts/
---

<div class="max-w-3xl mx-auto px-4 py-16">
  <h1 class="text-3xl sm:text-4xl font-display font-bold mb-4 animate-fade-in-up">Archive</h1>
  <p class="text-base-content/50 text-base mb-10 animate-fade-in-up" style="animation-delay: 0.05s">All posts, newest first.</p>

  <div class="flex flex-wrap gap-2 mb-10 animate-fade-in-up" style="animation-delay: 0.1s" id="archive-tag-filters">
    <button type="button" class="tag-filter-btn active" data-tag="all">All</button>
    {% for tag in collections.tagList %}
    <button type="button" class="tag-filter-btn" data-tag="{{ tag }}">{{ tag | tagDisplay }}</button>
    {% endfor %}
  </div>

  <ul class="space-y-1">
  {% for post in collections.posts | reverse %}
    {% set postTags = post.data.tags | contentTags %}
    <li class="archive-post flex items-baseline gap-4 py-2.5 border-b border-base-200 last:border-0 animate-fade-in-up" style="animation-delay: {{ 0.12 + loop.index0 * 0.03 }}s" data-tags="{{ postTags | join(',') }}">
      <time class="flex-shrink-0 w-36 text-sm font-mono text-base-content/40" datetime="{{ post.date }}">
        {{ post.date.getFullYear() }}, {{ post.date.getMonth() | toThreeLetterMonth }} {{ post.date.getDate() }}
      </time>
      <div class="flex-grow min-w-0">
        <a href="{{ post.url | url }}" class="text-lg hover:text-primary transition-colors duration-150">
          {{ post.data.title }}
        </a>
        {% if postTags.length %}
        <span class="hidden sm:inline ml-2">
          {% for tag in postTags %}
          <span class="text-xs font-mono text-base-content/30">{{ tag | tagDisplay }}{% if not loop.last %} &middot; {% endif %}</span>
          {% endfor %}
        </span>
        {% endif %}
      </div>
    </li>
  {% endfor %}
  </ul>
</div>

<script src="{{ '/js/tag-filter.js' | url }}"></script>
<script>
  TagFilter.install({
    filterContainer: '#archive-tag-filters',
    postSelector: '.archive-post',
    staggerSeconds: 0.03,
    syncUrl: true
  });
</script>
